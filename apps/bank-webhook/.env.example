ZAP_SECRET=
# Minutes an onramp transaction may sit in Initiated/Processing before the
# reconciler auto-fails it and releases the locked balance. Default 1440 (24h);
# lower this for local testing, e.g. 2.
ONRAMP_TIMEOUT_MINUTES=1440
# Shared secret required on the x-reconcile-secret header for POST /internal/reconcile.
RECONCILE_SECRET=